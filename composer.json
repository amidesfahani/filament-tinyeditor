{
    "name": "visualbuilder/filament-tinyeditor",
    "description": "Filament TinyMce Editor v6",
    "license": "MIT",
    "keywords": ["laravel", "filament", "tinyeditor", "tinymce"],
    "authors": [
        {
            "name": "Amid Esfahani",
            "email": "amid.esfahani@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "tinymce/tinymce": "^7.3.0"
    },
    "autoload": {
        "psr-4": {
            "Visualbuilder\\FilamentTinyEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Visualbuilder\\FilamentTinyEditor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Visualbuilder\\FilamentTinyEditor\\TinyeditorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.13",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
